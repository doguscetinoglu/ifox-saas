generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Platform ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum AutomationStatus {
  PENDING
  IN_PROGRESS
  DONE
  REJECTED
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String
  name        String
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  companyName String?
  phone       String?

  subscriptions       UserSubscription[]
  paymentRequests     PaymentRequest[]
  automationRequests  AutomationRequest[]
  passwordResetTokens PasswordResetToken[]

  // Modül ilişkileri
  ciroKayitlar  CiroKayit[]
  ciroHedefleri CiroHedef[]
  borcMusteriler BorcMusteri[]
  crmMusteriler  CrmMusteri[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id
  name        String
  slug        String  @unique
  description String
  price       Int     @default(1000)
  icon        String
  gradient    String
  isRequest   Boolean @default(false)
  sortOrder   Int     @default(0)

  subscriptions      UserSubscription[]
  paymentRequests    PaymentRequest[]
  automationRequests AutomationRequest[]
}

model UserSubscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  productId String
  product   Product            @relation(fields: [productId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model PaymentRequest {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  amount     Int
  status     PaymentStatus @default(PENDING)
  notes      String?
  notifiedAt DateTime?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([userId])
}

model AutomationRequest {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  description String?
  status      AutomationStatus @default(PENDING)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Modül: Ciro Takip ───────────────────────────────────────────────────────

model CiroKayit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tarih      DateTime
  tutar      Float
  satisAdedi Int      @default(0)
  kategori   String?
  aciklama   String?
  createdAt  DateTime @default(now())

  @@index([userId, tarih])
}

model CiroHedef {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  ayKey      String
  ciroHedef  Float  @default(0)
  satisHedef Int    @default(0)

  @@unique([userId, ayKey])
}

// ─── Modül: Borç Takip ───────────────────────────────────────────────────────

enum BorcDurum {
  BEKLIYOR
  KISMI
  ODENDI
  GECIKTI
}

model BorcMusteri {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kod       String
  ad        String
  telefon   String?
  email     String?
  sehir     String?
  borclar   Borc[]
  odemeler  BorcOdeme[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kod])
  @@index([userId])
}

model Borc {
  id          String      @id @default(cuid())
  musteri     BorcMusteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  musteriId   String
  belgeNo     String?
  tutar       Float
  vadeTarihi  DateTime
  belgeTarihi DateTime
  durum       BorcDurum   @default(BEKLIYOR)
  aciklama    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([musteriId])
}

model BorcOdeme {
  id           String      @id @default(cuid())
  musteri      BorcMusteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  musteriId    String
  tutar        Float
  odenmeTarihi DateTime
  yontem       String?
  aciklama     String?
  createdAt    DateTime    @default(now())

  @@index([musteriId])
}

// ─── Modül: Fox CRM ──────────────────────────────────────────────────────────

model CrmMusteri {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  ad        String
  email     String?
  telefon   String?
  sirket    String?
  notlar    String?
  tickets   CrmTicket[]
  projeler  CrmProje[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model CrmTicket {
  id        String      @id @default(cuid())
  userId    String
  musteriId String?
  musteri   CrmMusteri? @relation(fields: [musteriId], references: [id])
  konu      String
  icerik    String
  durum     String      @default("Yeni")
  oncelik   String      @default("Normal")
  yanitlar  CrmYanit[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model CrmYanit {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    CrmTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  icerik    String
  dahili    Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model CrmProje {
  id        String        @id @default(cuid())
  userId    String
  musteriId String?
  musteri   CrmMusteri?   @relation(fields: [musteriId], references: [id])
  ad        String
  aciklama  String?
  durum     String        @default("Devam Ediyor")
  adimlar   CrmProjeAdim[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}

model CrmProjeAdim {
  id      String     @id @default(cuid())
  projeId String
  proje   CrmProje   @relation(fields: [projeId], references: [id], onDelete: Cascade)
  ad      String
  sira    Int        @default(0)
  durum   String     @default("Beklemede")
  gorevler CrmGorev[]
}

model CrmGorev {
  id        String       @id @default(cuid())
  adimId    String
  adim      CrmProjeAdim @relation(fields: [adimId], references: [id], onDelete: Cascade)
  baslik    String
  aciklama  String?
  durum     String       @default("Beklemede")
  sonTarih  DateTime?
  createdAt DateTime     @default(now())
}
